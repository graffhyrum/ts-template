{
  "name": "ts-template",
  "version": "0.3.0",
  "description": "Personal TypeScript project template with a quiet quality gate.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun scripts/coverage-threshold.ts",
    "typecheck": "bun check",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "rule-validator": "rule-validator",
    "stepdown": "stepdown-rule \"src/**/*.ts\" \"scripts/**/*.ts\" \"config.ts\"",
    "crap4ts": "bun scripts/crap-gate.ts",
    "vet": "bun scripts/vet.ts",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "mutate4ts": "mutate4ts src/store.ts",
    "mutate4ts:scan": "mutate4ts --scan src/store.ts"
  },
  "dependencies": {
    "arkenv": "^0.8.1",
    "arktype": "^2.2.9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "@graffhyrum/crap4ts": "https://github.com/graffhyrum/ts-quality/releases/download/crap4ts-v2.1.4/graffhyrum-crap4ts-2.1.4.tgz",
    "mutate4ts": "https://github.com/graffhyrum/ts-quality/releases/download/mutate4ts-v1.0.1/mutate4ts-1.0.1.tgz",
    "@graff/rule-validator": "https://github.com/graffhyrum/ts-quality/releases/download/rule-validator-v1.2.1/graff-rule-validator-1.2.1.tgz",
    "@stepdown/analyzer": "https://github.com/graffhyrum/ts-quality/releases/download/stepdown-rule-v0.4.7/stepdown-analyzer-0.4.7.tgz"
  }
}

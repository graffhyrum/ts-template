{
	"name": "ts-template",
	"version": "0.2.0",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"init": "bun src/cli.ts",
		"dev": "bun --watch src/index.ts",
		"build": "bun build src/index.ts --target bun --outdir ./dist",
		"start": "NODE_ENV=production bun dist/index.js",
		"test": "AGENT=1 bun test --coverage",
		"test:coverage": "bun test --coverage 2>&1 | node scripts/validate-coverage.js",
		"test:e2e": "echo 'e2e tests not implemented yet'",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"fix": "biome check --write .",
		"fastvet": "bun typecheck && bun fix && bun run scripts/rule-validator.ts && bun run test",
		"vet": "bun fastvet && bun test:e2e",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"prepare": "husky",
		"os-update": "openspec --version && openspec update"
	},
	"dependencies": {
		"@typescript/native-preview": "^7.0.0-dev.20260104.1",
		"arktype": "^2.1.29",
		"arkenv": "^0.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@changesets/cli": "^2.29.8",
		"@inquirer/prompts": "^7.3.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"bun-types": "^1.3.5",
		"chalk": "^5.4.1",
		"glob": "13.0.0",
		"husky": "^9.1.7",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
